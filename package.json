{
  "name": "@govuk-one-login/di-ipv-cri-common-express",
  "version": "18.0.0",
  "description": "Express libraries and utilities for use building GOV.UK One Login Credential Issuers",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.*",
    "npm": ">=10.*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/govuk-one-login/ipv-cri-common-express"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/govuk-one-login/ipv-cri-common-express/issues"
  },
  "homepage": "https://github.com/govuk-one-login/ipv-cri-common-express#readme",
  "scripts": {
    "build:cjs": "npx tsc --outDir dist/cjs --module commonjs --moduleResolution node10",
    "build:esm": "npx tsc --outDir dist/esm",
    "build": "npm run build:esm && npm run build:cjs",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:fix": "npm run lint:eslint -- --fix && npm run lint:prettier -- --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./bootstrap/*": {
      "import": "./dist/esm/bootstrap/*",
      "require": "./dist/cjs/bootstrap/*"
    },
    "./components/*": {
      "import": "./dist/esm/components/*",
      "require": "./dist/cjs/components/*"
    },
    "./lib/*": {
      "import": "./dist/esm/lib/*",
      "require": "./dist/cjs/lib/*"
    },
    "./routes/*": {
      "import": "./dist/esm/routes/*",
      "require": "./dist/cjs/routes/*"
    }
  },
  "dependencies": {
    "async": "3.2.6",
    "body-parser": "1.20.9",
    "compression": "1.8.2",
    "connect-redis": "6.1.3",
    "cookie-parser": "1.4.7",
    "debug": "4.3.7",
    "deep-clone-merge": "1.5.5",
    "express-session": "1.18.2",
    "fakeredis": "2.0.0",
    "frameguard": "4.0.0",
    "helmet": "8.1.0",
    "hmpo-config": "4.0.0",
    "hmpo-logger": "9.0.0",
    "i18next": "26.3.4",
    "i18next-fs-backend": "2.6.6",
    "i18next-http-middleware": "3.9.7",
    "lodash.differencewith": "4.5.0",
    "nocache": "3.0.4",
    "on-finished": "2.4.1",
    "overload-protection": "1.2.3",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "redis": "4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@govuk-one-login/frontend-passthrough-headers": "1.3.2",
    "@tsconfig/node22": "^22.0.7",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "4.22.3",
    "globals": "^17.8.0",
    "hmpo-components": "8.0.5",
    "hmpo-form-wizard": "16.0.0",
    "hmpo-i18n": "8.0.1",
    "hmpo-reqres": "3.0.0",
    "lint-staged": "15.5.2",
    "nock": "^14.0.15",
    "nodemon": "^3.1.14",
    "nunjucks": "3.2.4",
    "prettier": "3.2.5",
    "proxyquire": "2.1.3",
    "reqres": "3.0.1",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@govuk-one-login/frontend-passthrough-headers": "^1.0.0",
    "@govuk-one-login/frontend-ui": "^5.3.1",
    "express": "^4.21.0",
    "govuk-frontend": "^5.0.0",
    "hmpo-components": "^7.1.0 || ^8.0.5",
    "hmpo-form-wizard": ">=12.0.6",
    "hmpo-i18n": "^8.0.1",
    "nunjucks": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "hmpo-components": {
      "optional": true
    },
    "hmpo-form-wizard": {
      "optional": true
    },
    "hmpo-i18n": {
      "optional": true
    }
  },
  "overrides": {
    "@govuk-one-login/frontend-ui": {
      "hmpo-components": "$hmpo-components"
    }
  }
}
