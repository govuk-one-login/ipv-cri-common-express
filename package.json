{
  "name": "@govuk-one-login/di-ipv-cri-common-express",
  "version": "19.0.2",
  "description": "Express libraries and utilities for use building GOV.UK One Login Credential Issuers",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.*",
    "npm": ">=10.*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/govuk-one-login/ipv-cri-common-express"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/govuk-one-login/ipv-cri-common-express/issues"
  },
  "homepage": "https://github.com/govuk-one-login/ipv-cri-common-express#readme",
  "scripts": {
    "build:cjs": "npx tsc --outDir dist/cjs --module commonjs --moduleResolution node10",
    "build:esm": "npx tsc --outDir dist/esm",
    "build": "rm -rf dist && npm run build:esm && npm run build:cjs && cp -r src/components dist/components",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./bootstrap/*": {
      "import": "./dist/esm/bootstrap/*",
      "require": "./dist/cjs/bootstrap/*"
    },
    "./components": {
      "import": "./dist/components",
      "require": "./dist/components"
    },
    "./components/*": {
      "import": "./dist/components/*",
      "require": "./dist/components/*"
    },
    "./lib/*": {
      "import": "./dist/esm/lib/*",
      "require": "./dist/cjs/lib/*"
    },
    "./routes/*": {
      "import": "./dist/esm/routes/*",
      "require": "./dist/cjs/routes/*"
    }
  },
  "dependencies": {
    "body-parser": "1.20.9",
    "compression": "1.8.2",
    "connect-redis": "6.1.3",
    "cookie-parser": "1.4.7",
    "deep-clone-merge": "1.5.5",
    "express-session": "1.18.2",
    "fakeredis": "2.0.0",
    "helmet": "8.1.0",
    "hmpo-config": "4.0.0",
    "i18next": "26.3.4",
    "i18next-fs-backend": "2.6.6",
    "i18next-http-middleware": "3.9.7",
    "lodash-es": "4.18.1",
    "nocache": "3.0.4",
    "on-finished": "2.4.1",
    "overload-protection": "1.2.3",
    "pino": "10.1.0",
    "redis": "4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@govuk-one-login/frontend-passthrough-headers": "1.3.2",
    "@tsconfig/node22": "^22.0.7",
    "@vitest/coverage-v8": "5.1.0",
    "chokidar": "^3.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "4.22.3",
    "globals": "^17.8.0",
    "hmpo-components": "8.0.5",
    "hmpo-form-wizard": "16.0.0",
    "hmpo-i18n": "8.0.1",
    "hmpo-reqres": "3.0.0",
    "jsdom": "^31.0.1",
    "nock": "^14.0.15",
    "nunjucks": "3.2.4",
    "prettier": "3.2.5",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@govuk-one-login/frontend-passthrough-headers": "^1.0.0",
    "@govuk-one-login/frontend-ui": "^5.3.1",
    "express": "^4.21.0",
    "govuk-frontend": "^5.0.0",
    "hmpo-components": "^7.1.0 || ^8.0.5",
    "hmpo-form-wizard": ">=12.0.6",
    "hmpo-i18n": "^8.0.1",
    "nunjucks": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "hmpo-components": {
      "optional": true
    },
    "hmpo-form-wizard": {
      "optional": true
    },
    "hmpo-i18n": {
      "optional": true
    }
  },
  "overrides": {
    "@govuk-one-login/frontend-ui": {
      "hmpo-components": "$hmpo-components"
    }
  }
}
